---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- Language Selection Screen -->
  <div
    data-theme="dark"
    id="language-selection-screen"
    class="fixed inset-0 z-[60] flex flex-col items-center justify-center bg-slate-950"
  >
    <!-- Background Effects -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-blue-900/20 via-slate-950 to-slate-950"
      >
      </div>
      <div
        class="absolute top-0 left-0 w-full h-px bg-linear-to-r from-transparent via-blue-500/50 to-transparent"
      >
      </div>
      <div
        class="absolute bottom-0 left-0 w-full h-px bg-linear-to-r from-transparent via-blue-500/50 to-transparent"
      >
      </div>
    </div>

    <div class="relative z-10 text-center space-y-12 max-w-4xl px-6">
      <!-- Title & Subtitle -->
      <div class="space-y-2">
        <h1
          class="text-6xl md:text-8xl font-black text-white tracking-tighter uppercase tech-text-shadow"
        >
          ESCAPE <span class="text-blue-500">THE FLOOD</span>
        </h1>
        <div
          class="flex items-center justify-center gap-3 text-lg font-mono text-blue-400/80 tracking-widest"
        >
          <span data-i18n="ui.loading.subtitle">PROTOCOL: CIVIL PROTECTION</span
          >
        </div>
      </div>

      <!-- Language Buttons -->
      <div class="flex flex-col sm:flex-row gap-6 w-full max-w-xl mx-auto pt-8">
        <button
          data-lang="el"
          class="language-btn group relative overflow-hidden bg-slate-900/80 hover:bg-blue-600 border border-blue-500/30 hover:border-blue-400 p-8 flex-1 transition-all duration-300 transform hover:-translate-y-1"
        >
          <div
            class="absolute inset-0 bg-blue-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
          >
          </div>
          <div class="relative z-10 flex flex-col items-center gap-3">
            <span class="text-4xl">🇬🇷</span>
            <span
              class="text-sm font-bold text-blue-100 tracking-[0.2em] group-hover:text-white"
              >ΕΛΛΗΝΙΚΑ</span
            >
          </div>
        </button>

        <button
          data-lang="en"
          class="language-btn group relative overflow-hidden bg-slate-900/80 hover:bg-blue-600 border border-blue-500/30 hover:border-blue-400 p-8 flex-1 transition-all duration-300 transform hover:-translate-y-1"
        >
          <div
            class="absolute inset-0 bg-blue-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
          >
          </div>
          <div class="relative z-10 flex flex-col items-center gap-3">
            <span class="text-4xl">🇬🇧</span>
            <span
              class="text-sm font-bold text-blue-100 tracking-[0.2em] group-hover:text-white"
              >ENGLISH</span
            >
          </div>
        </button>
      </div>

      <p class="text-slate-500 text-xs font-mono tracking-widest uppercase">
        Select Language // Επιλέξτε Γλώσσα
      </p>
    </div>
  </div>

  <!-- Start Screen -->
  <div
    id="start-screen"
    class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-slate-950"
    style="display: none;"
  >
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <!-- Cyber Grid Background -->
      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] z-10 bg-size-[100%_2px,3px_100%] pointer-events-none"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-blue-900/20 via-slate-950 to-slate-950"
      >
      </div>
    </div>

    <div class="relative z-20 text-center space-y-12">
      <div class="space-y-2 animate-pulse">
        <h1
          class="text-6xl font-black text-white tracking-tighter uppercase tech-text-shadow"
        >
          ESCAPE <span class="text-blue-500">THE FLOOD</span>
        </h1>
        <div
          class="flex items-center justify-center gap-2 text-sm font-mono text-blue-400"
        >
          <span class="w-2 h-2 bg-emerald-500 rounded-full animate-ping"></span>
          <span data-i18n="ui.start.systemOnline">SYSTEMS ONLINE</span>
        </div>
      </div>

      <button
        id="start-game-btn"
        class="group relative px-12 py-4 bg-transparent border border-blue-500/30 hover:border-blue-400 transition-all duration-300"
      >
        <div
          class="absolute inset-0 bg-blue-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
        >
        </div>
        <span
          class="text-xl font-mono font-bold text-white tracking-[0.2em] group-hover:text-blue-200"
          data-i18n="ui.start.pressStart"
        >
          PRESS START
        </span>
      </button>
    </div>

    <!-- Footer Info -->
    <div
      class="absolute bottom-8 text-[10px] font-mono text-slate-600 uppercase tracking-widest"
    >
      v2.0.4 // TACTICAL INTERFACE // AWAITING INPUT
    </div>
  </div>

  <!-- Loading Screen -->
  <div
    id="loading-screen"
    class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-slate-950"
    style="display: none;"
  >
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-blue-900/10 via-slate-950 to-slate-950"
      >
      </div>
    </div>

    <div class="relative z-10 text-center space-y-8 max-w-md px-6 w-full">
      <!-- Title -->
      <div class="space-y-1">
        <h1 class="text-3xl font-black text-white tracking-widest uppercase">
          INITIALIZING
        </h1>
        <p
          id="loading-subtitle"
          class="text-sm font-mono text-blue-500/80"
          data-i18n="ui.loading.subtitle"
        >
          SYSTEM STARTUP SEQUENCE
        </p>
      </div>

      <!-- Loading Progress -->
      <div class="w-full space-y-2">
        <div class="flex justify-between text-xs font-mono tracking-wider">
          <p
            id="loading-text"
            class="text-slate-400"
            data-i18n="ui.loading.loading"
          >
            LOADING ASSETS...
          </p>
          <p id="loading-percentage" class="text-blue-400">0%</p>
        </div>
        <div class="w-full h-1 bg-slate-900 overflow-hidden">
          <div
            id="loading-progress-bar"
            class="h-full bg-blue-500 shadow-[0_0_10px_rgba(59,130,246,0.5)] transition-all duration-300 ease-out relative"
            style="width: 0%"
          >
          </div>
        </div>
        <p
          id="loading-status"
          class="text-slate-600 text-[10px] font-mono text-center uppercase"
          data-i18n="ui.loading.preparing"
        >
          Waiting for synchronization...
        </p>
      </div>
    </div>
  </div>

  <!-- CRT Vignette Overlay (Global) -->
  <div
    class="fixed inset-0 pointer-events-none z-100 bg-[radial-gradient(circle_at_center,transparent_50%,rgba(0,0,0,0.4)_100%)]"
  >
  </div>
  <div
    class="fixed inset-0 pointer-events-none z-99 opacity-[0.03] bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
  >
  </div>

  <canvas id="renderCanvas" class="h-screen w-screen bg-black"></canvas>

  <!-- Phone Call Modal -->
  <dialog
    id="phone_call_modal"
    class="modal pointer-events-auto bg-black/60 backdrop-blur-sm"
  >
    <div
      class="modal-box tech-panel max-w-sm w-full p-0 overflow-hidden border-l-4 border-l-emerald-500"
    >
      <!-- Tech Header -->
      <div
        class="bg-slate-900/50 p-4 border-b border-white/5 flex items-center justify-between"
      >
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
          <span
            class="text-xs font-mono text-emerald-400 tracking-widest uppercase"
            data-i18n="game.modals.incomingCall">INCOMING TRANSMISSION</span
          >
        </div>
        <span class="text-[10px] font-mono text-slate-500">SECURE LINE</span>
      </div>

      <div class="p-8 flex flex-col items-center gap-6">
        <!-- Caller Info -->
        <div class="text-center space-y-2">
          <div
            class="w-20 h-20 mx-auto bg-slate-800 rounded-full flex items-center justify-center border border-white/10 relative"
          >
            <div
              class="absolute inset-0 rounded-full border border-emerald-500/30 animate-ping"
            >
            </div>
            <span class="text-3xl">📞</span>
          </div>
          <h3
            class="text-2xl font-bold text-white tracking-tight"
            id="phone-caller-name"
            data-i18n="game.modals.center112"
          >
            Center 112
          </h3>
        </div>

        <!-- Action -->
        <button
          id="answer-call-btn"
          class="w-full group relative flex items-center justify-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white py-4 px-6 transition-all duration-200 uppercase font-bold tracking-wider text-sm clip-path-slant"
        >
          <div
            class="absolute inset-0 bg-emerald-400/20 -translate-x-full group-hover:translate-x-full transition-transform duration-700"
          >
          </div>
          <span data-i18n="game.modals.answer">ACCEPT TRANSMISSION</span>
        </button>
      </div>
    </div>
  </dialog>

  <!-- Instructional / Dialogue Modal -->
  <dialog
    id="dialogue_modal"
    class="modal pointer-events-auto bg-black/40 backdrop-blur-sm"
  >
    <div
      class="modal-box tech-panel w-11/12 max-w-3xl p-0 border-l-4 border-l-amber-400"
    >
      <div class="bg-slate-900/80 p-6 md:p-8 flex gap-6">
        <!-- Avatar Placeholder (Optional) -->
        <div class="hidden md:flex flex-col items-center justify-start pt-2">
          <div
            class="w-16 h-16 bg-slate-800 border border-amber-500/30 flex items-center justify-center text-2xl"
          >
            ⚠️
          </div>
        </div>

        <div class="flex-1 space-y-4">
          <div
            class="flex items-baseline justify-between border-b border-white/5 pb-2"
          >
            <h3
              id="dialogue-speaker"
              class="text-lg font-bold text-amber-400 tracking-widest uppercase"
            >
              SYSTEM
            </h3>
            <span class="text-[10px] font-mono text-slate-500"
              >PRIORITY MSG</span
            >
          </div>

          <p
            id="dialogue-text"
            class="text-base md:text-lg text-slate-200 leading-relaxed font-light"
          >
            <!-- Text injected via JS -->
          </p>

          <div class="modal-action pt-4 flex justify-end">
            <form method="dialog">
              <button
                class="tech-btn-sm text-amber-400 hover:text-amber-300 border border-amber-500/30 hover:border-amber-400/60 px-6 py-2"
              >
                <span
                  class="text-xs font-bold tracking-widest"
                  data-i18n="ui.buttons.acknowledge">ACKNOWLEDGE</span
                >
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  <!-- Quiz Modal -->
  <dialog
    id="quiz_modal"
    class="modal pointer-events-auto bg-black/80 backdrop-blur-md"
  >
    <div
      class="modal-box tech-panel w-11/12 max-w-5xl p-0 flex flex-col h-[85vh] md:h-auto md:max-h-[85vh]"
    >
      <!-- Header -->
      <div
        class="bg-slate-900/90 p-6 border-b border-white/10 flex items-center gap-4 shrink-0"
      >
        <div
          class="w-10 h-10 bg-blue-600/20 flex items-center justify-center border border-blue-500/50"
        >
          <span class="text-blue-400 text-lg">?</span>
        </div>
        <div>
          <h3
            class="text-sm text-blue-400 font-mono tracking-widest uppercase mb-1"
            data-i18n="game.modals.quizTitle"
          >
            DECISION REQUIRED
          </h3>
          <div class="h-1 w-full bg-slate-800 rounded-full overflow-hidden">
            <div class="h-full w-1/3 bg-blue-500"></div>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div class="flex-1 overflow-y-auto p-6 md:p-10 bg-slate-950/50">
        <p
          id="quiz-question"
          class="text-lg md:text-2xl text-white font-medium leading-relaxed mb-8 md:mb-12 max-w-4xl"
        >
          <!-- Question Text -->
        </p>

        <!-- Grid for Options -->
        <div
          id="quiz-options"
          class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-4"
        >
          <!-- Options injected via JS -->
        </div>
      </div>
    </div>
  </dialog>

  <!-- Thermometer Alert Modal -->
  <dialog
    id="thermometer_modal"
    class="modal pointer-events-auto bg-red-950/80 backdrop-blur-md"
  >
    <div
      class="modal-box tech-panel w-11/12 max-w-lg p-0 border-l-4 border-l-red-500 border-r-4 border-r-red-500"
    >
      <div
        class="bg-linear-to-b from-red-900/20 to-slate-900 p-8 text-center space-y-6"
      >
        <div
          class="w-20 h-20 mx-auto bg-red-500/10 rounded-full flex items-center justify-center border border-red-500/50 animate-pulse"
        >
          <span class="text-4xl">🌡️</span>
        </div>

        <div class="space-y-2">
          <h3
            class="text-2xl font-black text-white tracking-widest uppercase"
            data-i18n="game.modals.thermometerModal.title"
          >
            CRITICAL HEAT
          </h3>
          <div class="text-4xl font-mono text-red-500 font-bold">41°C</div>
          <p
            class="text-red-400/80 text-sm font-mono uppercase tracking-wider"
            id="thermometer-level"
            data-i18n="game.modals.thermometerModal.level"
          >
            DANGER LEVEL: HIGH
          </p>
        </div>

        <div class="bg-red-950/50 p-4 border border-red-500/20 text-left">
          <p class="text-sm text-red-200 leading-relaxed">
            <span
              id="thermometer-msg1"
              data-i18n="game.modals.thermometerModal.message1"></span>
            <span
              id="thermometer-highlight"
              class="font-bold text-white"
              data-i18n="game.modals.thermometerModal.messagehighlight"></span>
            <span
              id="thermometer-msg2"
              data-i18n="game.modals.thermometerModal.message2"></span>
          </p>
        </div>

        <div class="modal-action justify-center pt-2">
          <form method="dialog">
            <button
              class="tech-btn-sm bg-red-600 hover:bg-red-500 text-white w-full py-3 px-8 uppercase font-bold tracking-widest text-xs"
            >
              <span data-i18n="ui.buttons.dismiss">DISMISS ALERT</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </dialog>
</Layout>

<dialog
  id="info-modal"
  class="modal pointer-events-auto bg-black/80 backdrop-blur-sm"
>
  <div class="modal-box tech-panel w-11/12 max-w-2xl p-0">
    <div
      class="flex items-center justify-between p-4 border-b border-white/10 bg-slate-900/50"
    >
      <h3
        class="text-xs font-mono text-blue-400 uppercase tracking-widest pl-2"
        id="info-modal-title"
        data-i18n="ui.infoModal.title"
      >
        OPERATIONAL GUIDE
      </h3>
      <form method="dialog">
        <button
          class="btn btn-sm btn-square btn-ghost text-slate-400 hover:text-white"
          >✕</button
        >
      </form>
    </div>

    <div class="p-6 md:p-8 space-y-8 bg-slate-950/80">
      <!-- Description -->
      <div class="flex gap-4">
        <div class="w-1 bg-blue-500/50 shrink-0"></div>
        <p
          id="info-modal-instructions"
          class="text-sm text-slate-300 leading-relaxed font-light"
          data-i18n="ui.infoModal.instructions"
        >
        </p>
      </div>

      <!-- Controls Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h4
            class="text-[10px] font-mono text-slate-500 uppercase tracking-widest border-b border-white/5 pb-2"
            data-i18n="ui.controls.movement"
          >
            Movement Controls
          </h4>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span
                class="text-xs text-slate-400 uppercase"
                data-i18n="ui.controls.moveKeys">Navigate</span
              >
              <div class="flex gap-1">
                <span class="tech-key">W</span>
                <span class="tech-key">A</span>
                <span class="tech-key">S</span>
                <span class="tech-key">D</span>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span
                class="text-xs text-slate-400 uppercase"
                data-i18n="ui.controls.runKey">Sprint</span
              >
              <span class="tech-key px-3">SHIFT</span>
            </div>
            <div class="flex items-center justify-between">
              <span
                class="text-xs text-slate-400 uppercase"
                data-i18n="ui.controls.jumpKey">Jump</span
              >
              <span class="tech-key px-4">SPACE</span>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <h4
            class="text-[10px] font-mono text-slate-500 uppercase tracking-widest border-b border-white/5 pb-2"
            data-i18n="ui.controls.camera"
          >
            Camera & View
          </h4>
          <div class="flex items-center gap-4 text-slate-400 text-sm">
            <div
              class="w-8 h-8 rounded border border-white/10 flex items-center justify-center"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                ></path></svg
              >
            </div>
            <span data-i18n="ui.controls.mouseDrag"
              >Drag mouse to look around</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<!-- HUD ELEMENTS -->

<!-- HUD ELEMENTS -->

<!-- Top Stats Bar -->
<div
  id="hud-top-bar"
  style="display: none;"
  class="absolute top-0 left-0 w-full p-4 md:p-6 flex justify-between items-start z-40 pointer-events-none"
>
  <!-- Distance / Objective -->
  <div
    class="bg-slate-900/80 backdrop-blur border-l-2 border-blue-500 px-6 py-3 clip-path-slant-right pointer-events-auto"
  >
    <div
      class="text-[10px] font-mono text-blue-400 uppercase tracking-widest mb-1"
      data-i18n="ui.hud.distance"
    >
      Target Distance
    </div>
    <div
      id="hud-distance"
      class="text-3xl font-mono font-bold text-white tracking-tight"
    >
      --
    </div>
  </div>

  <!-- Timer -->
  <div
    class="bg-slate-900/80 backdrop-blur border-r-2 border-pink-500 px-6 py-3 clip-path-slant-left text-right pointer-events-auto"
  >
    <div
      class="text-[10px] font-mono text-pink-400 uppercase tracking-widest mb-1"
      data-i18n="ui.hud.time"
    >
      Time Remaining
    </div>
    <div
      id="hud-timer"
      class="text-3xl font-mono font-bold text-white tracking-tight"
    >
      --:--
    </div>
  </div>
</div>

<!-- Bottom Center Action Bar -->
<div
  id="hud-bottom-bar"
  style="display: none;"
  class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-4 z-40"
>
  <!-- Help -->
  <button
    id="help-button"
    class="group relative w-14 h-14 bg-slate-900/80 backdrop-blur border border-white/10 hover:border-blue-400 transition-all duration-200 flex items-center justify-center rounded-sm"
  >
    <div
      class="absolute inset-0 bg-blue-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
    >
    </div>
    <span class="text-xl group-hover:scale-110 transition-transform">❓</span>
  </button>

  <!-- Quests/Info -->
  <button
    id="info-button"
    class="group relative w-14 h-14 bg-slate-900/80 backdrop-blur border border-white/10 hover:border-blue-400 transition-all duration-200 flex items-center justify-center rounded-sm"
  >
    <div
      class="absolute inset-0 bg-blue-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
    >
    </div>
    <span class="text-xl group-hover:scale-110 transition-transform">ℹ️</span>
  </button>

  <!-- Map -->
  <button
    id="map-button"
    class="group relative w-14 h-14 bg-slate-900/80 backdrop-blur border border-white/10 hover:border-blue-400 transition-all duration-200 flex items-center justify-center rounded-sm"
  >
    <div
      class="absolute inset-0 bg-blue-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
    >
    </div>
    <span class="text-xl group-hover:scale-110 transition-transform">🗺️</span>
  </button>
</div>

<script>
  import "../assets/scripts/main.ts";
</script>
<script is:inline>
  document.addEventListener("astro:page-load", () => {});
</script>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Inter:wght@300;400;600;800;900&display=swap");

  body {
    font-family: "Inter", sans-serif;
    background-color: #020617;
  }

  /* --- TECH THEME UTILS --- */

  .tech-panel {
    background-color: rgba(2, 6, 23, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 0 40px rgba(0, 0, 0, 0.8);
    color: #e2e8f0;
    border-radius: 2px;
  }

  .tech-text-shadow {
    text-shadow: 0 0 20px rgba(59, 130, 246, 0.5);
  }

  .tech-key {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    padding: 4px 8px;
    font-family: "JetBrains Mono", monospace;
    font-size: 10px;
    font-weight: 700;
    color: #94a3b8;
