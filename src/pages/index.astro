---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <!-- Language Selection Screen -->
  <div
    id="language-screen"
    class="fixed inset-0 z-60 flex flex-col items-center justify-center bg-slate-950"
  >
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-orange-900/20 via-slate-950 to-slate-950"
      >
      </div>
    </div>
    <div class="relative z-20 text-center space-y-10">
      <h1
        class="text-4xl font-black text-white tracking-tighter uppercase tech-text-shadow"
      >
        ΠΑΡΕ ΤΗ ΣΩΣΤΗ <span class="text-orange-500">ΑΠΟΦΑΣΗ!</span>
      </h1>
      <p class="text-sm font-mono text-slate-400 uppercase tracking-widest">
        Select Language / Επιλέξτε Γλώσσα
      </p>
      <div class="flex gap-6 justify-center">
        <button
          id="lang-el-btn"
          class="group relative flex flex-col items-center gap-3 px-10 py-6 bg-transparent border border-orange-500/30 hover:border-orange-400 transition-all duration-300 min-w-[140px]"
        >
          <div
            class="absolute inset-0 bg-orange-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
          >
          </div>
          <span class="text-4xl">🇬🇷</span>
          <span
            class="text-sm font-mono font-bold text-white tracking-[0.15em] group-hover:text-orange-200"
            >ΕΛΛΗΝΙΚΑ</span
          >
        </button>
        <button
          id="lang-en-btn"
          class="group relative flex flex-col items-center gap-3 px-10 py-6 bg-transparent border border-orange-500/30 hover:border-orange-400 transition-all duration-300 min-w-[140px]"
        >
          <div
            class="absolute inset-0 bg-orange-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
          >
          </div>
          <span class="text-4xl">🇬🇧</span>
          <span
            class="text-sm font-mono font-bold text-white tracking-[0.15em] group-hover:text-orange-200"
            >ENGLISH</span
          >
        </button>
      </div>
    </div>
  </div>

  <!-- Start Screen -->
  <div
    id="start-screen"
    class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-slate-950"
    style="display: none;"
  >
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <!-- Cyber Grid Background -->
      <div
        class="absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] z-10 bg-size-[100%_2px,3px_100%] pointer-events-none"
      >
      </div>
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-orange-900/20 via-slate-950 to-slate-950"
      >
      </div>
    </div>

    <div class="relative z-20 text-center space-y-12">
      <div class="space-y-2 animate-pulse">
        <h1
          class="text-6xl font-black text-white tracking-tighter uppercase tech-text-shadow"
        >
          ΠΑΡΕ ΤΗ ΣΩΣΤΗ <span class="text-orange-500">ΑΠΟΦΑΣΗ!</span>
        </h1>
        <div
          class="flex items-center justify-center gap-2 text-sm font-mono text-orange-400"
        >
          <span class="w-2 h-2 bg-emerald-500 rounded-full animate-ping"></span>
          <span data-i18n="ui.start.systemOnline">SYSTEMS ONLINE</span>
        </div>
      </div>

      <button
        id="start-game-btn"
        class="group relative px-12 py-4 bg-transparent border border-orange-500/30 hover:border-orange-400 transition-all duration-300"
      >
        <div
          class="absolute inset-0 bg-orange-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
        >
        </div>
        <span
          class="text-xl font-mono font-bold text-white tracking-[0.2em] group-hover:text-orange-200"
          data-i18n="ui.start.pressStart"
        >
          PRESS START
        </span>
      </button>
    </div>

    <!-- Footer Info -->
    <div
      class="absolute bottom-8 text-[10px] font-mono text-slate-600 uppercase tracking-widest"
    >
      v2.0.4 // TACTICAL INTERFACE // AWAITING INPUT
    </div>
  </div>

  <!-- Loading Screen -->
  <div
    id="loading-screen"
    class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-slate-950"
    style="display: none;"
  >
    <div class="absolute inset-0 overflow-hidden pointer-events-none">
      <div
        class="absolute inset-0 bg-[radial-gradient(circle_at_center,var(--tw-gradient-stops))] from-orange-900/10 via-slate-950 to-slate-950"
      >
      </div>
    </div>

    <div class="relative z-10 text-center space-y-8 max-w-md px-6 w-full">
      <!-- Title -->
      <div class="space-y-1">
        <h1 class="text-3xl font-black text-white tracking-widest uppercase">
          INITIALIZING
        </h1>
        <p
          id="loading-subtitle"
          class="text-sm font-mono text-orange-500/80"
          data-i18n="ui.loading.subtitle"
        >
          SYSTEM STARTUP SEQUENCE
        </p>
      </div>

      <!-- Loading Progress -->
      <div class="w-full space-y-2">
        <div class="flex justify-between text-xs font-mono tracking-wider">
          <p
            id="loading-text"
            class="text-slate-400"
            data-i18n="ui.loading.loading"
          >
            LOADING ASSETS...
          </p>
          <p id="loading-percentage" class="text-orange-400">0%</p>
        </div>
        <div class="w-full h-1 bg-slate-900 overflow-hidden">
          <div
            id="loading-progress-bar"
            class="h-full bg-orange-500 shadow-[0_0_10px_rgba(59,130,246,0.5)] transition-all duration-300 ease-out relative"
            style="width: 0%"
          >
          </div>
        </div>
        <p
          id="loading-status"
          class="text-slate-600 text-[10px] font-mono text-center uppercase"
          data-i18n="ui.loading.preparing"
        >
          Waiting for synchronization...
        </p>
      </div>
    </div>
  </div>

  <!-- CRT Vignette Overlay (Global) -->
  <div
    class="fixed inset-0 pointer-events-none z-100 bg-[radial-gradient(circle_at_center,transparent_50%,rgba(0,0,0,0.4)_100%)]"
  >
  </div>
  <div
    class="fixed inset-0 pointer-events-none z-99 opacity-[0.03] bg-[url('https://grainy-gradients.vercel.app/noise.svg')]"
  >
  </div>

  <canvas id="renderCanvas" class="h-screen w-screen bg-black"></canvas>

  <!-- Phone Call Modal -->
  <dialog
    id="phone_call_modal"
    class="modal pointer-events-auto bg-black/60 backdrop-blur-sm"
  >
    <div
      class="modal-box tech-panel max-w-sm w-full p-0 overflow-hidden border-l-4 border-l-emerald-500"
    >
      <!-- Tech Header -->
      <div
        class="bg-slate-900/50 p-4 border-b border-white/5 flex items-center justify-between"
      >
        <div class="flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
          <span
            class="text-xs font-mono text-emerald-400 tracking-widest uppercase"
            data-i18n="game.modals.incomingCall">INCOMING TRANSMISSION</span
          >
        </div>
        <span class="text-[10px] font-mono text-slate-500">SECURE LINE</span>
      </div>

      <div class="p-8 flex flex-col items-center gap-6">
        <!-- Caller Info -->
        <div class="text-center space-y-2">
          <div
            class="w-20 h-20 mx-auto bg-slate-800 rounded-full flex items-center justify-center border border-white/10 relative"
          >
            <div
              class="absolute inset-0 rounded-full border border-emerald-500/30 animate-ping"
            >
            </div>
            <span class="text-3xl">📞</span>
          </div>
          <h3
            class="text-2xl font-bold text-white tracking-tight"
            id="phone-caller-name"
            data-i18n="game.modals.center112"
          >
            Center 112
          </h3>
        </div>

        <!-- Action -->
        <button
          id="answer-call-btn"
          class="w-full group relative flex items-center justify-center gap-3 bg-emerald-600 hover:bg-emerald-500 text-white py-4 px-6 transition-all duration-200 uppercase font-bold tracking-wider text-sm clip-path-slant"
        >
          <div
            class="absolute inset-0 bg-emerald-400/20 -translate-x-full group-hover:translate-x-full transition-transform duration-700"
          >
          </div>
          <span data-i18n="game.modals.answer">ACCEPT TRANSMISSION</span>
        </button>
      </div>
    </div>
  </dialog>

  <!-- Instructional / Dialogue Modal -->
  <dialog
    id="dialogue_modal"
    class="modal pointer-events-auto bg-black/60 backdrop-blur-sm"
  >
    <div
      class="modal-box w-[95vw] max-w-2xl p-0 bg-[#0b1120] border border-white/8 max-h-[85dvh] flex flex-col overflow-hidden"
      style="border-top: 3px solid #f97316;"
    >
      <!-- Header -->
      <div
        class="flex items-center gap-3 px-5 py-4 shrink-0"
        style="background: linear-gradient(135deg, #5f2e1e 0%, #40200f 100%); border-bottom: 1px solid rgba(249, 115, 22, 0.3);"
      >
        <div
          class="w-10 h-10 rounded-full flex items-center justify-center shrink-0"
          style="background: rgba(249, 115, 22, 0.25); border: 2px solid rgba(249, 115, 22, 0.6);"
        >
          <span class="text-lg">📢</span>
        </div>
        <div class="flex-1 min-w-0">
          <h3
            id="dialogue-speaker"
            class="text-xs font-mono font-bold tracking-[0.15em] uppercase truncate"
            style="color: #fb923c;"
          >
            SYSTEM
          </h3>
          <span
            id="dialogue-urgent"
            class="text-sm font-semibold text-slate-100"
            data-i18n="ui.urgentMessage">URGENT MESSAGE</span
          >
        </div>
      </div>

      <!-- Body -->
      <div class="flex-1 overflow-y-auto px-6 py-6">
        <p
          id="dialogue-text"
          class="text-[15px] sm:text-base text-slate-200 leading-[1.8] whitespace-pre-line"
        >
        </p>
      </div>

      <!-- Action -->
      <div class="px-5 py-4 border-t border-white/5 flex justify-end shrink-0" style="background: rgba(15, 23, 42, 0.5);">
        <form method="dialog">
          <button
            class="px-8 py-3 text-xs font-bold tracking-widest uppercase transition-all active:scale-95 text-white"
            style="background: linear-gradient(135deg, #ea580c, #f97316); border: 1px solid rgba(249, 115, 22, 0.6); box-shadow: 0 0 20px rgba(249, 115, 22, 0.2);"
            data-i18n="ui.buttons.acknowledge"
          >
            Έλαβα το μήνυμα!
          </button>
        </form>
      </div>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>

  <!-- Quiz Modal -->
  <dialog id="quiz_modal" class="modal quiz-fullscreen pointer-events-auto">
    <div class="quiz-card">
      <!-- ── Header ── -->
      <div class="quiz-header">
        <div class="quiz-header-icon">?</div>
        <div class="flex-1 min-w-0">
          <p class="quiz-header-label" data-i18n="game.modals.quizTitle">
            ΠΡΟΤΕΙΝΟΜΕΝΕΣ ΑΛΛΑΓΕΣ
          </p>
          <p class="quiz-header-sub" data-i18n="ui.quizSelectAnswer">
            Select the correct answer
          </p>
        </div>
      </div>

      <!-- ── Riddle (scrollable, capped height) ── -->
      <div id="quiz-riddle" class="quiz-riddle hidden">
        <div class="quiz-riddle-tag" data-i18n="ui.riddleTag">📖 RIDDLE</div>
      </div>

      <!-- ── Scrollable body (question + options) ── -->
      <div class="quiz-body">
        <!-- Question -->
        <p id="quiz-question" class="quiz-question"></p>

        <!-- Options -->
        <div id="quiz-options" class="quiz-options"></div>
      </div>
    </div>
  </dialog>

  <!-- Thermometer Alert Modal -->
  <dialog
    id="thermometer_modal"
    class="modal pointer-events-auto bg-red-950/80 backdrop-blur-md"
  >
    <div
      class="modal-box tech-panel w-11/12 max-w-lg p-0 border-l-4 border-l-red-500 border-r-4 border-r-red-500"
    >
      <div
        class="bg-linear-to-b from-red-900/20 to-slate-900 p-8 text-center space-y-6"
      >
        <div
          class="w-20 h-20 mx-auto bg-red-500/10 rounded-full flex items-center justify-center border border-red-500/50 animate-pulse"
        >
          <span class="text-4xl">🌡️</span>
        </div>

        <div class="space-y-2">
          <h3
            class="text-2xl font-black text-white tracking-widest uppercase"
            data-i18n="game.modals.thermometerModal.title"
          >
            CRITICAL HEAT
          </h3>
          <div class="text-4xl font-mono text-red-500 font-bold">41°C</div>
          <p
            class="text-red-400/80 text-sm font-mono uppercase tracking-wider"
            id="thermometer-level"
            data-i18n="game.modals.thermometerModal.level"
          >
            DANGER LEVEL: HIGH
          </p>
        </div>

        <div class="bg-red-950/50 p-4 border border-red-500/20 text-left">
          <p class="text-sm text-red-200 leading-relaxed">
            <span
              id="thermometer-msg1"
              data-i18n="game.modals.thermometerModal.message1"></span>
            <span
              id="thermometer-highlight"
              class="font-bold text-white"
              data-i18n="game.modals.thermometerModal.messagehighlight"></span>
            <span
              id="thermometer-msg2"
              data-i18n="game.modals.thermometerModal.message2"></span>
          </p>
        </div>

        <div class="modal-action justify-center pt-2">
          <form method="dialog">
            <button
              class="tech-btn-sm bg-red-600 hover:bg-red-500 text-white w-full py-3 px-8 uppercase font-bold tracking-widest text-xs"
            >
              <span data-i18n="ui.buttons.dismiss">DISMISS ALERT</span>
            </button>
          </form>
        </div>
      </div>
    </div>
  </dialog>
</Layout>

<dialog
  id="info-modal"
  class="modal pointer-events-auto bg-black/80 backdrop-blur-sm"
>
  <div class="modal-box tech-panel w-11/12 max-w-2xl p-0">
    <div
      class="flex items-center justify-between p-4 border-b border-white/10 bg-slate-900/50"
    >
      <h3
        class="text-xs font-mono text-orange-400 uppercase tracking-widest pl-2"
        id="info-modal-title"
        data-i18n="ui.infoModal.title"
      >
        OPERATIONAL GUIDE
      </h3>
      <form method="dialog">
        <button
          class="btn btn-sm btn-square btn-ghost text-slate-400 hover:text-white"
          >✕</button
        >
      </form>
    </div>

    <div class="p-6 md:p-8 space-y-8 bg-slate-950/80">
      <!-- Description -->
      <div class="flex gap-4">
        <div class="w-1 bg-orange-500/50 shrink-0"></div>
        <p
          id="info-modal-instructions"
          class="text-sm text-slate-300 leading-relaxed font-light"
          data-i18n="ui.infoModal.instructions"
        >
        </p>
      </div>

      <!-- Controls Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="space-y-4">
          <h4
            class="text-[10px] font-mono text-slate-500 uppercase tracking-widest border-b border-white/5 pb-2"
            data-i18n="ui.controls.movement"
          >
            Movement Controls
          </h4>
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span
                class="text-xs text-slate-400 uppercase"
                data-i18n="ui.controls.moveKeys">Navigate</span
              >
              <div class="flex gap-1">
                <span class="tech-key">W</span>
                <span class="tech-key">A</span>
                <span class="tech-key">S</span>
                <span class="tech-key">D</span>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span
                class="text-xs text-slate-400 uppercase"
                data-i18n="ui.controls.runKey">Sprint</span
              >
              <span class="tech-key px-3">SHIFT</span>
            </div>
            <div class="flex items-center justify-between">
              <span
                class="text-xs text-slate-400 uppercase"
                data-i18n="ui.controls.jumpKey">Jump</span
              >
              <span class="tech-key px-4">SPACE</span>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <h4
            class="text-[10px] font-mono text-slate-500 uppercase tracking-widest border-b border-white/5 pb-2"
            data-i18n="ui.controls.camera"
          >
            Camera & View
          </h4>
          <div class="flex items-center gap-4 text-slate-400 text-sm">
            <div
              class="w-8 h-8 rounded border border-white/10 flex items-center justify-center"
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                ><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                  d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                ></path></svg
              >
            </div>
            <span data-i18n="ui.controls.mouseDrag"
              >Drag mouse to look around</span
            >
          </div>
        </div>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<!-- HUD ELEMENTS -->

<!-- HUD ELEMENTS -->

<!-- Top Stats Bar -->
<div
  id="hud-top-bar"
  style="display: none;"
  class="absolute top-0 left-0 w-full p-4 md:p-6 flex justify-between items-start z-40 pointer-events-none"
>
  <!-- Distance / Objective -->
  <div
    class="bg-slate-900/80 backdrop-blur border-l-2 border-orange-500 px-6 py-3 clip-path-slant-right pointer-events-auto"
  >
    <div
      class="text-[10px] font-mono text-orange-400 uppercase tracking-widest mb-1"
      data-i18n="ui.hud.distance"
    >
      ΣΤΑΘΜΟΣ
    </div>
    <div
      id="hud-distance"
      class="text-3xl font-mono font-bold text-white tracking-tight"
    >
      --
    </div>
  </div>

  <!-- Timer -->
  <div
    class="bg-slate-900/80 backdrop-blur border-r-2 border-orange-500 px-6 py-3 clip-path-slant-left pointer-events-auto"
  >
    <div
      class="text-[10px] font-mono text-orange-400 uppercase tracking-widest mb-1"
      data-i18n="ui.hud.time"
    >
      ΧΡΟΝΟΣ
    </div>
    <div
      id="hud-timer"
      class="text-3xl font-mono font-bold text-white tracking-tight"
    >
      4:00
    </div>
  </div>
</div>

<!-- Position capture toast (dev tool — press P) -->
<div
  id="pos-toast"
  class="pos-toast-hidden fixed top-20 left-1/2 -translate-x-1/2 z-50 pointer-events-none"
>
  <div
    class="bg-emerald-950 border border-emerald-500/60 rounded-lg px-5 py-4 shadow-2xl shadow-emerald-900/40 min-w-[280px]"
  >
    <div class="flex items-center gap-2 mb-2">
      <span class="text-emerald-400 text-sm font-bold">📍 Position copied!</span
      >
    </div>
    <pre
      id="pos-toast-text"
      class="text-emerald-200 text-xs font-mono leading-relaxed whitespace-pre">
    </pre>
  </div>
</div>

<!-- Proximity Panel: shows riddle when player is near a quest point -->
<div
  id="proximity-panel"
  style="display: none;"
  class="fixed bottom-28 left-1/2 -translate-x-1/2 w-full max-w-lg px-4 z-40 pointer-events-none"
>
  <div
    class="bg-slate-900/95 backdrop-blur border border-orange-500/50 border-l-4 border-l-orange-500 p-4 rounded-sm shadow-2xl shadow-orange-900/40"
  >
    <div class="flex items-center gap-2 mb-2">
      <div class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></div>
      <span
        class="text-xs font-mono text-orange-400 uppercase tracking-widest"
        data-i18n="ui.proximityLabel"
        >Point of Interest — Get closer to answer!</span
      >
    </div>
    <p
      id="proximity-riddle-text"
      class="text-sm text-slate-100 leading-relaxed"
    >
    </p>
  </div>
</div>

<!-- Bottom Center Action Bar -->
<div
  id="hud-bottom-bar"
  style="display: none;"
  class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-4 z-40"
>
  <!-- Help -->
  <button
    id="help-button"
    class="group relative w-14 h-14 bg-slate-900/80 backdrop-blur border border-white/10 hover:border-orange-400 transition-all duration-200 flex items-center justify-center rounded-sm"
  >
    <div
      class="absolute inset-0 bg-orange-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
    >
    </div>
    <span class="text-xl group-hover:scale-110 transition-transform">❓</span>
  </button>

  <!-- Quests/Info -->
  <button
    id="info-button"
    class="group relative w-14 h-14 bg-slate-900/80 backdrop-blur border border-white/10 hover:border-orange-400 transition-all duration-200 flex items-center justify-center rounded-sm"
  >
    <div
      class="absolute inset-0 bg-orange-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
    >
    </div>
    <span class="text-xl group-hover:scale-110 transition-transform">ℹ️</span>
  </button>

  <!-- Map -->
  <button
    id="map-button"
    class="group relative w-14 h-14 bg-slate-900/80 backdrop-blur border border-white/10 hover:border-orange-400 transition-all duration-200 flex items-center justify-center rounded-sm"
  >
    <div
      class="absolute inset-0 bg-orange-500/10 opacity-0 group-hover:opacity-100 transition-opacity"
    >
    </div>
    <span class="text-xl group-hover:scale-110 transition-transform">🗺️</span>
  </button>
</div>

<script>
  import "../assets/scripts/main.ts";
</script>
<script is:inline>
  document.addEventListener("astro:page-load", () => {});
</script>

<style is:global>
